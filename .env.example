# Copy to .env and adjust (optional: the defaults work when the backend runs on this machine).

# Port the web app is served on (Docker).
WEB_PORT=8080
# Backend API base URL as seen from the web container. Default: the backend's port 3000 on this machine.
API_UPSTREAM=http://host.docker.internal:3000
# Backend API for the Vite dev server (pnpm dev).
VITE_API_PROXY=http://localhost:3000
